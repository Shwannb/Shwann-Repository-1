{
  "name": "safyr-deal-terminal",
  "version": "0.1.0",
  "private": true,
  "description": "Safyr Capital Partners — live deal-sourcing terminal (Phase 1)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "worker:edgar": "tsx workers/edgar.ts",
    "worker:edgar:once": "tsx workers/edgar.ts --once",
    "worker:classifier": "tsx workers/classifier.ts",
    "worker:classifier:once": "tsx workers/classifier.ts --once",
    "worker:rss": "tsx workers/rss.ts",
    "worker:rss:once": "tsx workers/rss.ts --once",
    "worker:ch": "tsx workers/companies_house.ts",
    "worker:ch:once": "tsx workers/companies_house.ts --once",
    "worker:newsapi": "tsx workers/newsapi.ts",
    "worker:newsapi:once": "tsx workers/newsapi.ts --once",
    "worker:gdelt": "tsx workers/gdelt.ts",
    "worker:gdelt:once": "tsx workers/gdelt.ts --once",
    "worker:ws": "tsx workers/ws.ts",
    "test:edgar": "tsx scripts/test-edgar.ts",
    "test:classifier": "tsx scripts/test-classifier.ts",
    "test:api": "tsx scripts/test-api.ts",
    "test:rss": "tsx scripts/test-rss.ts",
    "test:ch": "tsx scripts/test-ch.ts",
    "test:newsapi": "tsx scripts/test-newsapi.ts",
    "test:gdelt": "tsx scripts/test-gdelt.ts",
    "test:ws": "tsx scripts/test-ws.ts",
    "test:all": "for t in edgar classifier api rss ch newsapi gdelt ws; do npx tsx scripts/test-$t.ts || exit 1; done"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.90.0",
    "@upstash/redis": "^1.34.0",
    "next": "15.1.0",
    "pg": "^8.13.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.13",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
