# Postgres (Supabase-compatible connection string).
# docker-compose uses postgres://safyr:safyr@postgres:5432/safyr inside the
# compose network; override DATABASE_URL here for an external database.
DATABASE_URL=postgres://safyr:safyr@localhost:5432/safyr

# Anthropic — used by the classifier to tag sector/geography/deal type/size.
# Without this, the classifier worker will error and no deals are promoted.
ANTHROPIC_API_KEY=

# SEC EDGAR requires a contact email in the User-Agent per their fair-access policy.
EDGAR_USER_AGENT="Safyr Capital Deal Terminal compliance@safyr.capital"

# Companies House UK — free REST API key from developer.company-information.service.gov.uk.
# Optional; the ch worker idles when this is unset.
CH_API_KEY=

# NewsAPI — https://newsapi.org/. Optional; newsapi worker idles when unset.
NEWSAPI_KEY=

# GDELT DOC API requires no key.

# Retention worker — delete orphan news_items older than this many days
# (items linked to a promoted deal are kept indefinitely). Default 90.
RETENTION_DAYS=90

# Authentication. When set, the terminal and /api/* require this token. Pass
# it as `Authorization: Bearer <token>` for API clients, or sign in via the
# /login page (browser sets an httpOnly session cookie). Leave blank for
# local dev / docker compose without auth.
SAFYR_API_TOKEN=

# WebSocket push server port (LISTEN/NOTIFY fan-out). Default 3030.
WS_PORT=3030
# Exposed to the browser so the terminal client knows where to connect.
NEXT_PUBLIC_WS_PORT=3030

# Upstash Redis — reserved for multi-instance deployments (worker locks,
# cross-pod dedupe, ws fan-out). Phase 1 runs single-instance and does not
# require Redis; leave unset for docker-compose.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Phase 2 (disabled in Phase 1) — contact enrichment via licensed provider only.
# See COMPLIANCE.md. Must not be wired into any Phase 1 worker.
APOLLO_API_KEY=
