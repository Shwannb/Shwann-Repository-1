# Postgres (Supabase-compatible connection string)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/safyr

# Upstash Redis (used for worker locks, dedupe TTLs, ws pub/sub)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Anthropic — used by the classifier to tag sector/geography/deal type/size
ANTHROPIC_API_KEY=

# SEC EDGAR requires a contact email in the User-Agent per their fair-access policy
EDGAR_USER_AGENT="Safyr Capital Deal Terminal compliance@safyr.capital"

# Phase 2 (disabled in Phase 1) — contact enrichment via licensed provider only
APOLLO_API_KEY=
